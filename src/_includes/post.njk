---
layout: base.njk
---
<article class="post">
  <header class="post-head">
    <p class="kind">{{ kind }}{% if number %} {{ number }}{% endif %}</p>
    <h1>{{ title }}</h1>
    <time datetime="{{ page.date | isoDate }}">{{ page.date | longDate }}</time>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>
