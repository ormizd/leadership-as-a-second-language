---
layout: base.njk
title: Leadership as a Second Language
---
<section class="phrase" aria-labelledby="phrase-said">
  <p class="said" id="phrase-said"><del>{{ phrases[0].said }}</del></p>
  <p class="meant"><span class="meant-text">{{ phrases[0].meant }}</span></p>
  <p class="gloss">Translated from Specialist into Leader. <button type="button" class="another" hidden>Another phrase</button></p>
</section>

<section class="intro">
  <p>Most of us learn leadership the way adults learn a language: late, mid-conversation, and with an accent we can hear in ourselves. These are notes on becoming fluent in a new version of yourself, until leading feels as natural as your first language.</p>
  <p class="byline">By {{ site.author }}, a leadership coach who spent sixteen years teaching English as a second language.</p>
</section>

<section id="writing" class="writing" aria-labelledby="writing-title">
  {% set posts = collections.writing %}
  {% if posts.length %}
  {% set latest = posts | last %}
  {% set first = posts | first %}
  {% if posts.length > 1 %}
  <a class="start-here" href="{{ first.url }}">
    <span class="start-label">New here?</span>
    <span>Start at the beginning with <strong>{{ first.data.kind }}{% if first.data.number %} {{ first.data.number }}{% endif %}: {{ first.data.title }}</strong> →</span>
  </a>
  {% endif %}
  <h2 id="writing-title">Latest</h2>
  <a class="featured" href="{{ latest.url }}">
    <span class="entry-kind">{{ latest.data.kind }}{% if latest.data.number %} {{ latest.data.number }}{% endif %}</span>
    <span class="featured-title">{{ latest.data.title }}</span>
    {% if latest.data.summary %}<span class="entry-summary">{{ latest.data.summary }}</span>{% endif %}
    <span class="featured-meta"><time datetime="{{ latest.date | isoDate }}">{{ latest.date | longDate }}</time><span class="read">Read the note →</span></span>
  </a>

  {% if posts.length > 1 %}
  <h2 class="archive-title">All writing</h2>
  <ol class="archive">
    {% for post in posts %}
    <li{% if post.url == latest.url %} class="is-latest"{% endif %}>
      <a href="{{ post.url }}">
        <span class="archive-num">{% if post.data.number %}{{ post.data.number }}{% else %}{{ post.data.kind }}{% endif %}</span>
        <span class="archive-title-text">{{ post.data.title }}</span>
        {% if post.url == latest.url %}<span class="archive-new">New</span>{% endif %}
      </a>
    </li>
    {% endfor %}
  </ol>
  {% endif %}
  {% else %}
  <h2 id="writing-title">Writing</h2>
  <p class="muted">The first note arrives soon.</p>
  {% endif %}
</section>

<script>
(function () {
  var phrases = {{ phrases | dump | safe }};
  var said = document.querySelector(".said del");
  var meant = document.querySelector(".meant-text");
  var box = document.querySelector(".phrase");
  var btn = document.querySelector(".another");
  if (!said || phrases.length < 2) return;
  var i = 0;
  btn.hidden = false;
  btn.addEventListener("click", function () {
    i = (i + 1) % phrases.length;
    box.classList.remove("play");
    said.textContent = phrases[i].said;
    meant.textContent = phrases[i].meant;
    void box.offsetWidth; // restart the animation
    box.classList.add("play");
  });
  box.classList.add("play");
})();
</script>
